# Use the LAN IP of this computer for other devices on the local network.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
DAYO_PORT=8080

# Optional browser key; visible to app users if configured.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=

# Cloud mirror credentials. Keep the service-role key out of all VITE_* variables.
CLOUD_SUPABASE_URL=
CLOUD_SUPABASE_SERVICE_ROLE_KEY=
SYNC_INTERVAL_MS=300000
SYNC_POLL_MS=2000
SYNC_REQUEST_TIMEOUT_MS=180000

# For the Supabase CLI local stack on Windows Docker Desktop.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
