# Supabase project settings (use the publishable/anon key in browser code).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini is called directly from the browser in local/demo mode.
# This key is visible to anyone who can use the deployed site.
VITE_GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.5-flash-lite).
VITE_GEMINI_MODEL=
